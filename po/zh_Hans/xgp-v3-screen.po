msgid ""
msgstr ""
"Language: zh_Hans\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "XGP Screen"
msgstr "XGP 屏幕"

msgid "General Settings"
msgstr "通用设置"

msgid "Enable display"
msgstr "启用屏幕"

msgid "Disabling the display stops the screen service and turns off the backlight."
msgstr "关闭后将停止屏幕服务并熄灭背光。"

msgid "Backlight brightness"
msgstr "背光亮度"

msgid "Display schedule"
msgstr "亮屏方式"

msgid "Always on"
msgstr "始终开启"

msgid "Fixed hours"
msgstr "固定时段"

msgid "On at sunrise, off at sunset"
msgstr "日出开启、日落关闭"

msgid "On time"
msgstr "开启时间"

msgid "Off time"
msgstr "关闭时间"

msgid "%s (hour)"
msgstr "%s（小时）"

msgid "%s (minute)"
msgstr "%s（分钟）"

msgid "Uses the router’s local time. An earlier off time means the next day."
msgstr "按照路由器的本地时间执行。关闭时间早于开启时间时，将于次日关闭。"

msgid "Choose different on and off times."
msgstr "请为开启和关闭选择不同的时间。"

msgid "Latitude"
msgstr "纬度"

msgid "Longitude"
msgstr "经度"

msgid "Enter decimal degrees from %d to %d."
msgstr "请输入 %d 至 %d 之间的十进制度数。"

msgid "Copy the Latitude and Longitude values for the router’s location."
msgstr "查询路由器所在地，将 Latitude 填入纬度、Longitude 填入经度。"

msgid "Look up coordinates on LatLong.net"
msgstr "在 LatLong.net 查询经纬度"

msgid "Frame rate limit"
msgstr "帧率上限"

msgid "The actual frame rate depends on the transition effect and screen content."
msgstr "实际帧率取决于切页效果和屏幕内容。"

msgid "%d FPS"
msgstr "%d 帧/秒"

msgid "Page transition"
msgstr "切页动画"

msgid "No animation"
msgstr "无动画"

msgid "Fade in"
msgstr "淡入"

msgid "Slide up"
msgstr "向上滑动"

msgid "Slide down"
msgstr "向下滑动"

msgid "Slide left"
msgstr "向左滑动"

msgid "Slide right"
msgstr "向右滑动"

msgid "Cover up"
msgstr "从下向上覆盖"

msgid "Cover down"
msgstr "从上向下覆盖"

msgid "Cover left"
msgstr "从右向左覆盖"

msgid "Cover right"
msgstr "从左向右覆盖"

msgid "Default page duration (ms)"
msgstr "默认停留时间（毫秒）"

msgid "Page rotation"
msgstr "页面轮播"

msgid "Enabled pages are shown in the order listed here. Use the drag handles or ↑ and ↓ to reorder them. A duration of 0 uses the default."
msgstr "已启用的页面按列表顺序轮播。使用拖动手柄或 ↑、↓ 调整顺序。停留时间填 0 时使用默认值。"

msgid "System information"
msgstr "系统信息"

msgid "Hostname, system name, system version, and kernel version."
msgstr "主机名、系统名称、系统版本和内核版本。"

msgid "System status"
msgstr "系统状态"

msgid "Load averages, memory usage, uptime, and local time."
msgstr "平均负载、内存占用、运行时间和本地时间。"

msgid "Network information"
msgstr "网络信息"

msgid "Modem, WAN, and LAN IP addresses, active connections, and online LAN device count."
msgstr "Modem、WAN 和 LAN 的 IP 地址，以及活动连接数和 LAN 在线设备数。"

msgid "Modem information"
msgstr "调制解调器信息"

msgid "Modem firmware version, temperature, voltage, carrier, network type, band or CQI, and AMBR."
msgstr "固件版本、温度、电压、运营商、网络类型、频段或 CQI，以及 AMBR。"

msgid "Modem signal"
msgstr "调制解调器信号"

msgid "Values and signal bars for metrics such as RSRP, RSRQ, and SINR."
msgstr "RSRP、RSRQ 和 SINR 等信号指标的数值与信号条。"

msgid "Traffic statistics"
msgstr "流量统计"

msgid "Today's and all-time upload and download totals for monitored interfaces."
msgstr "监控接口的今日和累计上传、下载流量。"

msgid "Temperature monitor"
msgstr "温度监控"

msgid "CPU, GPU, Wi-Fi, and 5G modem temperatures."
msgstr "CPU、GPU、Wi-Fi 网卡和 5G 模组的温度。"

msgid "Enabled"
msgstr "已启用"

msgid "Move %s up"
msgstr "上移「%s」"

msgid "Move %s down"
msgstr "下移「%s」"

msgid "Drag to reorder %s"
msgstr "拖动「%s」调整顺序"

msgid "Page duration (ms)"
msgstr "停留时间（毫秒）"

msgid "Monitored devices"
msgstr "监控设备"

msgid "Enter a device name or prefix, such as wwan. An empty list uses eth1, wwan, wan and pppoe."
msgstr "每项填写一个网络设备名或前缀，例如 wwan。列表为空时使用 eth1、wwan、wan 和 pppoe。"

msgid "Reset traffic statistics"
msgstr "清零流量统计"

msgid "Reset statistics"
msgstr "清零"

msgid "Cancel"
msgstr "取消"

msgid "Today's and all-time traffic totals will be cleared the next time the display shows the traffic statistics page."
msgstr "屏幕下次显示流量统计页时，将清除今日及累计流量。"

msgid "Traffic reset requested."
msgstr "已请求清零流量统计。"

msgid "Unable to request a traffic reset."
msgstr "无法请求清零流量统计。"

msgid "Enable at least one page before enabling the display."
msgstr "启用屏幕时，至少要启用一个轮播页面。"

msgid "Add at most 16 device names or prefixes."
msgstr "最多可添加 16 个设备名或前缀。"

msgid "Enter a valid device name or prefix."
msgstr "请输入有效的网络设备名或前缀。"
