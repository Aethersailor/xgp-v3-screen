#!/bin/sh /etc/rc.common

START=99
STOP=01
USE_PROCD=1
PROG=/usr/zz/zz_xgp_screen

start_service() {
    [ "$(uci -q get xgp_screen.main.enabled)" = 1 ] || return 0

    if [ -x /etc/init.d/xgp-lcd ] && /etc/init.d/xgp-lcd enabled; then
        logger -t zz_xgp_screen 'Disable and stop xgp-lcd before starting the LVGL screen'
        return 0
    fi

    /usr/zz/bind-panel.sh || return 1

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger xgp_screen
}

reload_service() {
    restart
}
